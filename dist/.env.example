OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROK_API_KEY=
LLM_CACHE_BACKEND=memory
LLM_CACHE_REDIS_URL=
WORKTREES_ENABLED=0

# Docker Compose publishes the container on this host address and port.
MCP_AGENT_MAIL_PUBLISH_ADDRESS=0.0.0.0
MCP_AGENT_MAIL_PUBLISH_PORT=8765

# MCP HTTP transport. Generate a strong, unique bearer token before deployment.
# docker-compose.yaml overrides HTTP_HOST and HTTP_PORT inside the container.
HTTP_HOST=0.0.0.0
HTTP_PORT=8765
HTTP_PATH=/api/
HTTP_BEARER_TOKEN=
# This bundle targets a trusted private/single-operator deployment. Static
# bearer tokens have no per-token role, so writer enables normal Agent Mail use.
HTTP_RBAC_ENABLED=true
HTTP_RBAC_DEFAULT_ROLE=writer
HTTP_ALLOW_LOCALHOST_UNAUTHENTICATED=false

# Human Mail UI cookie login, independent from HTTP_BEARER_TOKEN.
# For non-loopback access, set both MAIL_UI_PASSWORD (12-1024 characters)
# and MAIL_UI_SESSION_SECRET (at least 32 random characters).
MAIL_UI_USERNAME=operator
MAIL_UI_PASSWORD=
MAIL_UI_SESSION_SECRET=
MAIL_UI_SESSION_TTL_SECONDS=43200
MAIL_UI_LOGIN_RATE_LIMIT_PER_MINUTE=10
MAIL_UI_LOGIN_GLOBAL_RATE_LIMIT_PER_HOUR=200
MAIL_UI_LOGIN_MAX_TRACKED_CLIENTS=10000

# Shared HTTP rate limiting. The memory backend is suitable for this
# single-container Compose deployment.
HTTP_RATE_LIMIT_ENABLED=true
HTTP_RATE_LIMIT_PER_MINUTE=60
HTTP_RATE_LIMIT_BACKEND=memory
HTTP_RATE_LIMIT_REDIS_URL=
HTTP_RATE_LIMIT_REDIS_PREFIX=mcp-agent-mail
HTTP_RATE_LIMIT_REDIS_CONNECT_TIMEOUT_SECONDS=2
HTTP_RATE_LIMIT_REDIS_SOCKET_TIMEOUT_SECONDS=2
HTTP_REQUEST_LOG_ENABLED=false
TOOLS_LOG_ENABLED=false

# OpenTelemetry (optional).
HTTP_OTEL_ENABLED=false
OTEL_SERVICE_NAME=mcp-agent-mail
OTEL_EXPORTER_OTLP_ENDPOINT=

# Persistent MCP conversation identity. For remote browser confirmation,
# replace this with the externally reachable HTTPS base URL.
IDENTITY_BROWSER_CONFIRMATION_ENABLED=true
IDENTITY_CONFIRMATION_BASE_URL=http://127.0.0.1:8765
# Explicit opt-in for trusted LANs without HTTPS. When true, set the base URL
# to the LAN hostname and accept that confirmation traffic can be intercepted.
IDENTITY_CONFIRMATION_ALLOW_INSECURE_HTTP=false
IDENTITY_CONFIRMATION_TTL_SECONDS=300
IDENTITY_ADMIN_PRINCIPAL_CREDENTIAL_HASHES=

# docker-compose.yaml overrides these with persistent /data paths.
DATABASE_URL=sqlite+aiosqlite:////data/storage.sqlite3
DATABASE_ECHO=false
STORAGE_ROOT=/data/mailbox

# Attachments and images.
INLINE_IMAGE_MAX_BYTES=65536
CONVERT_IMAGES=true
KEEP_ORIGINAL_IMAGES=false
ALLOW_ABSOLUTE_ATTACHMENT_PATHS=false

# CORS is normally unnecessary for MCP clients and the server-rendered UI.
HTTP_CORS_ENABLED=false
HTTP_CORS_ORIGINS=
HTTP_CORS_ALLOW_CREDENTIALS=false
HTTP_CORS_ALLOW_METHODS=*
HTTP_CORS_ALLOW_HEADERS=*

# Background maintenance.
FILE_RESERVATIONS_CLEANUP_ENABLED=false
FILE_RESERVATIONS_CLEANUP_INTERVAL_SECONDS=60

# Message quotas and retention reporting.
QUOTA_ENABLED=true
QUOTA_ATTACHMENTS_LIMIT_BYTES=500000000
QUOTA_INBOX_LIMIT_COUNT=10000
RETENTION_REPORT_ENABLED=true
CONTACT_AUTO_RETRY_ENABLED=true
